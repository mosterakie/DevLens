# 复制为 .env 后按需修改。api 和 worker 启动时会自动读取它，
# 不需要额外设置环境变量。.env 已在 .gitignore 中，不会被提交。
#
# 真实的环境变量优先于这个文件，所以 CI 或生产环境直接导出变量即可，
# 不必改动文件。把 DOTENV_PATH 设为空字符串可以完全跳过读取。

# ---- 必填 ----
DATABASE_URL=postgres://devlens:devlens@127.0.0.1:5432/devlens?sslmode=disable

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- HTTP ----
PORT=8080

# 监听地址。默认 127.0.0.1：进程只在回环上监听，对外由反向代理承担，
# 这样即使云安全组被误开放，外部也无法直接连到进程。
# 容器或反代场景需要监听所有网卡时设为 0.0.0.0。
# 留空会被当作未设置，回退到 127.0.0.1（刻意的失败安全方向）。
BIND_ADDR=127.0.0.1

# 允许提供 X-Forwarded-For 的代理地址（逗号分隔，CIDR 或 IP）。
# 留空（默认）= 不信任任何代理：客户端 IP 取 TCP 对端地址，忽略该头。
# 必须留空，除非确实部署了反向代理并在这里声明其地址 ——
# X-Forwarded-For 可被客户端伪造，而限流按客户端 IP 分桶，
# 默认信任它等于允许调用方每次换一个伪造 IP 绕过限流。
# 例：TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=
LOG_LEVEL=info

# ---- LLM ----
#
# 留空 LLM_API_KEY 时，worker 会退回本地启发式分析器（关键词匹配），
# 整条链路在没有外部依赖时也能端到端跑通。
#
# 用 DeepSeek 时按下面的值填：
#   1. 去 https://platform.deepseek.com/api_keys 创建 key
#   2. 把 LLM_API_KEY 填成 sk-xxxx，务必不要把真实 key 提交到仓库
#
# BASE_URL 用 https://api.deepseek.com 即可，该地址同时兼容
# /chat/completions 和 /v1/chat/completions 两种路径。
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 请求服务端保证输出合法 JSON。DeepSeek 与 OpenAI 都支持；
# 若换成不支持该参数的兼容服务，设为 false。
LLM_JSON_MODE=true

# 单次调用的输出上限。设小了会被截断：截断的 JSON 无法解析，
# 而且重试也拿不到完整结果。实测一条普通日志约需 2400 tokens，
# 所以留到 4096。
LLM_MAX_TOKENS=4096

# 单次模型调用超时。整个分析任务预算 60s，留出重试空间。
# 实测 deepseek-flash 单次 3-11 秒。
ANALYZE_TIMEOUT=25s

# ---- 限流 ----
RATE_LIMIT_ANALYZE_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=200
