# 复制为 .env 后按需修改。不要提交真实的 .env。

# 必填
DATABASE_URL=postgres://devlens:devlens@127.0.0.1:5432/devlens?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# HTTP
PORT=8080
LOG_LEVEL=info

# LLM。留空时 worker 会退回本地启发式分析器，
# 这样整条链路在没有外部依赖时也能端到端跑通。
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
ANALYZE_TIMEOUT=25s

# 限流
RATE_LIMIT_ANALYZE_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=200